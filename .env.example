# Catalog of Futility — environment template
#
# Copy to `.env.local` and fill in. All variables are read by
# src/lib/supabase.ts at build time (Vite inlines anything prefixed VITE_).
#
# Both are OPTIONAL. Without them the archive still runs: authentication is
# disabled, `connectionError` is set, and every non-gated entry stays reachable.
# In a production build, missing credentials throw on purpose so a misconfigured
# deploy fails loudly instead of silently signing everybody out.

# Supabase project URL — Settings → API → Project URL
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon (public) key — Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY="your-anon-key"
